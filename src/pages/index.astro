      .sns-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-bottom: 10px; }
      
      .sns-btn {
        display: inline-flex; align-items: center; padding: 9px 18px; border-radius: 8px; 
        color: #ffffff !important; 
        background: linear-gradient(145deg, #575757, #484848); 
