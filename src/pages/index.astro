      /* 3階層目トグル（【テキストデータ抽出】など：スマホで横幅が潰れないようスリム化＋左アクセント線） */
      details.deep-toggle {
        background: rgba(0, 0, 0, 0.22);
        margin: 0.75rem 0; padding: 0.85rem 1rem; border-radius: 6px;
        border: 1px solid rgba(255, 255, 255, 0.04);
