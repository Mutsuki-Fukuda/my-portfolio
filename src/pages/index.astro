        font-weight: 400;
        color: #e2e8f0;
        font-size: 0.92rem;
      }
      .list-level-2 > .list-item-content::before {
        content: "▪";
        font-size: 0.8rem;
        top: 0.02rem;
        color: #9ca3af;
      }
      .list-children {
        margin-left: 0.4rem;
        padding-left: 0.9rem;
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        margin-top: 0.35rem;
      }

      .sub-heading {
        font-size: 1.02rem; font-weight: 700; color: #ffffff;
        margin: 1.1rem 0 0.55rem; padding-bottom: 0.25rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }
      .callout-box {
        display: flex; align-items: flex-start; gap: 10px;
        background: rgba(255,255,255,0.05); padding: 12px 14px;
        border-radius: 6px; margin: 0.7rem 0; font-size: 0.94rem;
        white-space: pre-wrap;
      }
      .callout-emoji { margin-right: 6px; flex-shrink: 0; }
      .quote-box {
        margin: 0.7rem 0; padding: 0.5rem 1rem;
        border-left: 3px solid #9ca3af; background: rgba(0,0,0,0.15);
        color: #d1d5db; white-space: pre-wrap;
      }
      .inline-code {
        background: rgba(0,0,0,0.3); padding: 2px 6px; border-radius: 4px;
        font-family: monospace; font-size: 0.88em; color: #93c5fd;
      }
      .notion-divider {
        border: none; border-top: 1px solid rgba(255,255,255,0.1);
        margin: 1.2rem 0;
      }

      /* ★ スマホ表示時の最適化：SNSボタンを「上段2×2（2/2）、下段3×2（3/3）」にピシッと整列させる */
      @media (max-width: 600px) {
        .top-spacer { height: 36px; }
        .container { padding: 0 16px 64px; }
        h1 { font-size: 1.45rem; margin-bottom: 1.8rem; }
        
        .sns-row-main {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 8px;
          margin-bottom: 8px;
        }
        .sns-row-sub {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 8px;
        }
        .sns-btn {
          width: 100%;
          padding: 9px 8px;
          font-size: 0.84rem;
        }
        .sns-icon {
          margin-right: 6px;
        }

        details.toggle-card { padding: 1rem 1.1rem; }
        summary.toggle-summary { font-size: 0.96rem; gap: 10px; }
        .toggle-chevron { width: 24px; height: 24px; }
        details.nested-toggle { padding: 0.85rem 0.95rem; }
        details.deep-toggle { padding: 0.75rem 0.85rem; }
        .list-children { margin-left: 0.25rem; padding-left: 0.7rem; }
      }
    </style>
  </head>
  <body>
    <div class="top-spacer"></div>
    
    <div class="container">
      <h1>福田睦晃 (Mutsuki Fukuda) - Personal Activity Archive</h1>

      <div class="ai-notice">
        <p>Notion上のデータを自動同期して公開している、検索エンジン・AIクローラー向けのページです。</p>
        <p>視認性に優れたポートフォリオをご覧になる方は、<strong><a href="https://share-atelier.notion.site/Mutsuki-Fukuda-Personal-Activity-Archive-3428555ac38580a6aa99c56cab18146c?source=copy_link" target="_blank" rel="noopener noreferrer">Notion</a></strong> へアクセスしてください。</p>
      </div>

      <div>
        {processedBlocks.map((block: any) => {
          if (block.type === 'intro_group') {
            return (
              <div class="intro-container">
                {block.blocks.map((introBlock: any) => {
                  const tData = introBlock[introBlock.type];
                  return <p class="intro-paragraph" set:html={renderRichTextHtml(tData.rich_text, true)} />;
                })}
              </div>
            );
          }

          if (block.type === 'sns_group') {
            const mainKeywords = ['instagram.com', 'x.com', 'twitter.com', 'youtube.com', 'facebook.com'];
            const mainLinks = block.links.filter((url: string) => mainKeywords.some(kw => url.includes(kw)));
            const subLinks = block.links.filter((url: string) => !mainKeywords.some(kw => url.includes(kw)));

            return (
              <div class="sns-section">
                {mainLinks.length > 0 && (
                  <div class="sns-row sns-row-main">
                    {mainLinks.map((url: string) => {
                      const sns = getSnsDetails(url);
                      return (
                        <a href={url} target="_blank" rel="noopener noreferrer" class="sns-btn">
                          <span class="sns-icon" set:html={sns.icon}></span>{sns.name}
                        </a>
                      );
                    })}
                  </div>
                )}
                {subLinks.length > 0 && (
                  <div class="sns-row sns-row-sub">
                    {subLinks.map((url: string) => {
                      const sns = getSnsDetails(url);
                      return (
                        <a href={url} target="_blank" rel="noopener noreferrer" class="sns-btn">
                          <span class="sns-icon" set:html={sns.icon}></span>{sns.name}
                        </a>
                      );
                    })}
                  </div>
                )}
              </div>
            );
          }

          const type = block.type;
          const typeData = block[type];
          const text = getPlainText(block);

          // 1階層目のトグルカード（左アクセントライン＋右端シェブロンアイコン）
          if (block.children && block.children.length > 0) {
            return (
              <details class="toggle-card">
                <summary class="toggle-summary">
                  <span class="summary-label" set:html={renderRichTextHtml(typeData?.rich_text || [], true) || '詳細を見る'} />
                  <span class="toggle-chevron">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </span>
                </summary>
                <div class="toggle-content" set:html={renderNestedBlocksHtml(block.children, 1, 0)} />
              </details>
            );
          }

          if (typeData && typeData.rich_text) {
            if (!text.trim()) return null; 
            if (text.startsWith('📂')) return <div class="section-title">{text}</div>;
            return <p class="intro-paragraph" set:html={renderRichTextHtml(typeData.rich_text, true)} />;
          }

          if (type === 'image') {
            const url = typeData.type === 'external' ? typeData.external.url : typeData.file.url;
            return <img src={resolveImageUrl(url)} alt="Activity Image" class="notion-image" loading="lazy" decoding="async" />;
          }

          return null;
        })}
      </div>
    </div>
  </body>
</html>
