  <body>
    <div class="top-spacer"></div>
    
    <div class="container">
      <h1>福田睦晃 (Mutsuki Fukuda) - Personal Activity Archive</h1>

      <div class="ai-notice">
        <p>Notion上のデータを自動同期して公開している、検索エンジン・AIクローラー向けのページです。</p>
        <p>視認性に優れたポートフォリオをご覧になる方は、<strong><a href="https://share-atelier.notion.site/Mutsuki-Fukuda-Personal-Activity-Archive-3428555ac38580a6aa99c56cab18146c?source=copy_link" target="_blank" rel="noopener noreferrer">Notion</a></strong> へアクセスしてください。</p>
      </div>

      <div>
        {processedBlocks.map((block: any) => {
          if (block.type === 'intro_group') {
            return (
              <div class="intro-container">
                {block.blocks.map((introBlock: any) => {
                  const tData = introBlock[introBlock.type];
                  // タグと中身を1行で密着させ、white-space: pre-wrapによる先頭インデント空白の混入を完全に防ぐ
                  return <p class="intro-paragraph">{tData.rich_text.map((t: any, idx: number) => {
                    const txt = idx === 0 ? t.plain_text.trimStart() : t.plain_text;
                    return t.href ? <a href={t.href} target="_blank" rel="noopener noreferrer">{txt}</a> : <span>{txt}</span>;
                  })}</p>;
                })}
              </div>
            );
          }

          if (block.type === 'sns_group') {
            const mainKeywords = ['instagram.com', 'x.com', 'twitter.com', 'youtube.com', 'facebook.com'];
            const mainLinks = block.links.filter((url: string) => mainKeywords.some(kw => url.includes(kw)));
            const subLinks = block.links.filter((url: string) => !mainKeywords.some(kw => url.includes(kw)));

            return (
              <div class="sns-section">
                {mainLinks.length > 0 && (
                  <div class="sns-row">
                    {mainLinks.map((url: string) => {
                      const sns = getSnsDetails(url);
                      return (
                        <a href={url} target="_blank" rel="noopener noreferrer" class="sns-btn">
                          <span class="sns-icon" set:html={sns.icon}></span>{sns.name}
                        </a>
                      );
                    })}
                  </div>
                )}
                {subLinks.length > 0 && (
                  <div class="sns-row">
                    {subLinks.map((url: string) => {
                      const sns = getSnsDetails(url);
                      return (
                        <a href={url} target="_blank" rel="noopener noreferrer" class="sns-btn">
                          <span class="sns-icon" set:html={sns.icon}></span>{sns.name}
                        </a>
                      );
                    })}
                  </div>
                )}
              </div>
            );
          }

          const type = block.type;
          const typeData = block[type];
          const text = getPlainText(block);

          // 1階層目のトグル（📂 Instagram Archive など）
          if (block.children && block.children.length > 0) {
            return (
              <details class="toggle-card">
                <summary class="toggle-summary">
                  <span class="toggle-icon">▶︎</span>
                  <span>{text || '詳細を見る'}</span>
                </summary>
                <div class="toggle-content">
                  {block.children.map((child: any) => {
                    // 2階層目のトグル（💡 #1 (Slide 1〜7) など）
                    if (child.children && child.children.length > 0) {
                      return (
                        <details class="nested-toggle">
                          <summary class="nested-summary">
                            <span class="nested-icon">▶︎</span>
                            <span>{getPlainText(child) || '画像 / 詳細を見る'}</span>
                          </summary>
                          <div class="nested-content">
                            {child.children.map((grandchild: any) => {
                              // ★ 3階層目のトグル（【テキストデータ抽出】など）と、その中の4階層目テキスト群
                              if (grandchild.children && grandchild.children.length > 0) {
                                return (
                                  <details class="deep-toggle">
                                    <summary class="nested-summary">
                                      <span class="nested-icon">▶︎</span>
                                      <span>{getPlainText(grandchild) || 'テキストデータを見る'}</span>
                                    </summary>
                                    <div class="deep-content">
                                      {grandchild.children.map((ggc: any) => {
                                        if (ggc.type === 'image') {
                                          const ggcUrl = ggc.image.type === 'external' ? ggc.image.external.url : ggc.image.file.url;
                                          return <img src={resolveImageUrl(ggcUrl)} alt="Slide Content Image" class="notion-image" loading="lazy" decoding="async" />;
                                        }
                                        if (isTextBlock(ggc.type)) {
                                          const ggcTextData = ggc[ggc.type]?.rich_text;
                                          if (!ggcTextData || ggcTextData.length === 0) return null;
                                          const isBullet = ggc.type === 'bulleted_list_item';
                                          return <div class={`toggle-text ${isBullet ? 'bullet-item' : ''}`}>{ggcTextData.map((t: any) => t.href ? <a href={t.href} target="_blank" rel="noopener noreferrer">{t.plain_text}</a> : <span>{t.plain_text}</span>)}</div>;
                                        }
                                        return null;
                                      })}
                                    </div>
                                  </details>
                                );
                              }

                              // 3階層目が画像の場合（スライド画像）
                              if (grandchild.type === 'image') {
                                const gcUrl = grandchild.image.type === 'external' ? grandchild.image.external.url : grandchild.image.file.url;
                                return <img src={resolveImageUrl(gcUrl)} alt="Nested Content Image" class="notion-image" loading="lazy" decoding="async" />;
                              }
                              // 3階層目が通常のテキストや箇条書きの場合
                              if (isTextBlock(grandchild.type)) {
                                const gcTextData = grandchild[grandchild.type]?.rich_text;
                                if (!gcTextData || gcTextData.length === 0) return null;
                                const isBullet = grandchild.type === 'bulleted_list_item';
                                return <div class={`toggle-text ${isBullet ? 'bullet-item' : ''}`}>{gcTextData.map((t: any) => t.href ? <a href={t.href} target="_blank" rel="noopener noreferrer">{t.plain_text}</a> : <span>{t.plain_text}</span>)}</div>;
                              }
                              return null;
                            })}
                          </div>
                        </details>
                      );
                    }

                    // 2階層目が画像の場合
                    if (child.type === 'image') {
                      const childUrl = child.image.type === 'external' ? child.image.external.url : child.image.file.url;
                      return <img src={resolveImageUrl(childUrl)} alt="Toggle Content Image" class="notion-image" loading="lazy" decoding="async" />;
                    }
                    // 2階層目が通常のテキストや箇条書きの場合（💬 キャプションや「・」の箇条書きなど）
                    if (isTextBlock(child.type)) {
                      const childTextData = child[child.type]?.rich_text;
                      if (!childTextData || childTextData.length === 0) return null;
                      const isBullet = child.type === 'bulleted_list_item';
                      return <div class={`toggle-text ${isBullet ? 'bullet-item' : ''}`}>{childTextData.map((t: any) => t.href ? <a href={t.href} target="_blank" rel="noopener noreferrer">{t.plain_text}</a> : <span>{t.plain_text}</span>)}</div>;
                    }
                    return null;
                  })}
                </div>
              </details>
            );
          }

          if (isTextBlock(type)) {
            if (!text.trim()) return null; 
            if (text.startsWith('📂')) return <div class="section-title">{text}</div>;
            
            const isBullet = type === 'bulleted_list_item';
            return <p class={`intro-paragraph ${isBullet ? 'bullet-item' : ''}`}>{typeData.rich_text.map((t: any, idx: number) => {
              const txt = idx === 0 ? t.plain_text.trimStart() : t.plain_text;
              return t.href ? <a href={t.href} target="_blank" rel="noopener noreferrer">{txt}</a> : <span>{txt}</span>;
            })}</p>;
          }

          if (type === 'image') {
            const url = typeData.type === 'external' ? typeData.external.url : typeData.file.url;
            return <img src={resolveImageUrl(url)} alt="Activity Image" class="notion-image" loading="lazy" decoding="async" />;
          }

          return null;
        })}
      </div>
    </div>
  </body>
</html>
