---
import { getNotionData } from "../lib/notion.ts";
const blocks = await getNotionData();

const getPlainText = (b: any) => {
  if (!b) return '';
  const type = b.type;
  if (!b[type] || !b[type].rich_text) return '';
  return b[type].rich_text.map((t: any) => t.plain_text).join('');
};

const getSnsDetails = (url: string) => {
  const svgWrapper = (path: string) => `<svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" style="display:block;"><path d="${path}"/></svg>`;
  
  if (url.includes('instagram.com')) return { name: 'Instagram', icon: svgWrapper("M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z") };
  if (url.includes('x.com') || url.includes('twitter.com')) return { name: 'X', icon: svgWrapper("M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 22.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.005 4.066H5.059z") };
  if (url.includes('youtube.com')) return { name: 'YouTube', icon: svgWrapper("M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z") };
  if (url.includes('facebook.com')) return { name: 'Facebook', icon: svgWrapper("M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z") };
  
  const defaultPath = "M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z";
  if (url.includes('threads.net') || url.includes('threads.com')) return { name: 'Threads', icon: svgWrapper(defaultPath) };
  if (url.includes('wantedly.com')) return { name: 'Wantedly', icon: svgWrapper(defaultPath) };
  if (url.includes('note.com')) return { name: 'note', icon: svgWrapper(defaultPath) };
  if (url.includes('youtrust.jp')) return { name: 'YOUTRUST', icon: svgWrapper(defaultPath) };
  if (url.includes('bsky.app')) return { name: 'Bluesky', icon: svgWrapper(defaultPath) };
  if (url.includes('mixi.social')) return { name: 'mixi', icon: svgWrapper(defaultPath) };
  
  return { name: 'Link', icon: svgWrapper(defaultPath) };
};

const processedBlocks: any[] = [];
let currentSnsGroup: string[] = [];
let currentIntroGroup: any[] = [];

blocks.forEach((block: any) => {
  const type = block.type;
  let snsUrl = '';
  
  if (block[type] && block[type].rich_text) {
    const linkObj = block[type].rich_text.find((t: any) => t.href);
    if (linkObj) snsUrl = linkObj.href;
  }
  if (!snsUrl) {
    const text = getPlainText(block);
    const match = text.match(/https?:\/\/[^\s]+/);
    if (match) snsUrl = match[0];
  }

  const isSns = snsUrl && (
    snsUrl.includes('instagram.com') || snsUrl.includes('x.com') || snsUrl.includes('twitter.com') || 
    snsUrl.includes('youtube.com') || snsUrl.includes('facebook.com') || snsUrl.includes('threads.net') || 
    snsUrl.includes('threads.com') || snsUrl.includes('wantedly.com') || snsUrl.includes('note.com') || 
    snsUrl.includes('youtrust.jp') || snsUrl.includes('bsky.app') || snsUrl.includes('mixi.social')
  );

  const plainText = getPlainText(block).trim();
  const isOnlyUrl = plainText.length > 0 && plainText.length <= snsUrl.length + 5;

  if (isSns && isOnlyUrl) {
    if (currentIntroGroup.length > 0) {
      processedBlocks.push({ type: 'intro_group', blocks: currentIntroGroup });
      currentIntroGroup = [];
    }
    currentSnsGroup.push(snsUrl);
  } else {
    if (currentSnsGroup.length > 0) {
      processedBlocks.push({ type: 'sns_group', links: currentSnsGroup });
      currentSnsGroup = [];
    }

    const hasChildren = block.children && block.children.length > 0;
    const isArchiveTitle = plainText.startsWith('📂');
    
    if (type === 'paragraph' && !hasChildren && !isArchiveTitle && plainText.length > 0) {
      currentIntroGroup.push(block);
    } else {
      if (currentIntroGroup.length > 0) {
        processedBlocks.push({ type: 'intro_group', blocks: currentIntroGroup });
        currentIntroGroup = [];
      }
      processedBlocks.push(block);
    }
  }
});
if (currentIntroGroup.length > 0) {
  processedBlocks.push({ type: 'intro_group', blocks: currentIntroGroup });
}
if (currentSnsGroup.length > 0) {
  processedBlocks.push({ type: 'sns_group', links: currentSnsGroup });
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>福田睦晃 (Mutsuki Fukuda) - Personal Activity Archive</title>
    <style is:global>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Segoe UI", Arial, sans-serif;
        background-color: #515151;
        color: #e5e7eb;
        margin: 0; padding: 0;
        line-height: 1.6;
      }
      
      .top-spacer { width: 100%; height: 60px; }
      
      .container {
        max-width: 800px; margin: 0 auto; padding: 0 24px 80px;
      }

      h1 { 
        color: #ffffff; margin-bottom: 2.5rem; text-align: center;
        font-size: 1.8rem; font-weight: 700; letter-spacing: 0.05em;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
      }
      
      .ai-notice {
        background: rgba(0, 0, 0, 0.2); border-radius: 8px; padding: 16px 24px;
        margin-bottom: 40px; font-size: 0.9rem; line-height: 1.6; color: #cbd5e1; 
        border: 1px solid rgba(255,255,255,0.1);
      }
      .ai-notice p { margin: 0 0 6px 0; }
      .ai-notice p:last-child { margin: 0; }
      .ai-notice a { font-weight: 500; color: #60a5fa; text-decoration: none; border-bottom: 1px solid rgba(96, 165, 250, 0.4); }
      .ai-notice a:hover { border-bottom-color: #60a5fa; }
      
      .intro-container {
        margin-bottom: 2rem;
      }
      
      .intro-paragraph {
        font-size: 1.05rem; 
        line-height: 1.9; 
        color: #f8fafc; 
        white-space: pre-wrap; 
        word-wrap: break-word; 
        letter-spacing: 0.02em;
        margin: 0 0 1.8rem 0;
      }
      .intro-paragraph:last-child {
        margin: 0;
      }

      .section-title {
        color: #ffffff; font-size: 1.25rem; font-weight: 600; margin-top: 3.5rem; margin-bottom: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 0.5rem;
      }
      .notion-image {
        width: 100%; max-height: 500px; object-fit: contain; border-radius: 8px; margin: 0.5rem 0;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2); background: rgba(0,0,0,0.2);
      }
      a { color: #60a5fa; text-decoration: none; border-bottom: 1px solid rgba(96, 165, 250, 0.4); }
      a:hover { border-bottom-color: #60a5fa; }

      /* 🌟 修正：SNSセクションとトグルカードの余白を絶妙なバランスに再調整（2rem） */
      .sns-section { margin-top: 2rem; margin-bottom: 2rem; }
      .sns-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-bottom: 12px; }
      
      .sns-btn {
        display: inline-flex; align-items: center; padding: 10px 20px; border-radius: 8px; 
        color: #ffffff !important; 
        background: linear-gradient(145deg, #575757, #484848); 
        font-weight: 500; font-size: 0.95rem; text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 4px 4px 10px rgba(0, 0, 0, 0.15), -2px -2px 8px rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
      }
      .sns-btn:hover { 
        transform: translateY(-2px); 
        box-shadow: 6px 6px 15px rgba(0, 0, 0, 0.2), -3px -3px 10px rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.2);
        background: linear-gradient(145deg, #5c5c5c, #4a4a4a);
      }
      .sns-icon { margin-right: 8px; display: flex; align-items: center; justify-content: center; opacity: 0.95; border: none; }

      details.toggle-card {
        background: linear-gradient(145deg, #4b4b4b, #3d3d3d);
        margin-bottom: 1.5rem; padding: 1.5rem 2rem; border-radius: 12px; 
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.12), -2px -2px 10px rgba(255, 255, 255, 0.03);
      }
      summary.toggle-summary {
        font-size: 1.1rem; font-weight: 600; cursor: pointer; color: #ffffff; 
        outline: none; list-style: none; display: flex; align-items: center;
      }
      summary.toggle-summary::-webkit-details-marker { display: none; }
      
      .toggle-icon {
        color: #9ca3af; font-size: 0.75rem; margin-right: 12px; margin-top: 2px;
        transition: transform 0.2s ease; display: inline-block; flex-shrink: 0;
      }
      details[open] > summary.toggle-summary .toggle-icon { transform: rotate(90deg); }
      
      .toggle-content { 
        margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.06); 
      }
      .toggle-text { margin-bottom: 1rem; line-height: 1.8; color: #e5e7eb; }

      details.nested-toggle {
        background: rgba(0, 0, 0, 0.15); 
        margin-bottom: 1rem; padding: 1.2rem 1.5rem; border-radius: 8px; 
        border: 1px solid rgba(255, 255, 255, 0.03);
        box-shadow: inset 2px 2px 5px rgba(0,0,0,0.1);
      }
      summary.nested-summary {
        font-size: 1rem; font-weight: 600; cursor: pointer; color: #ffffff; 
        outline: none; list-style: none; display: flex; align-items: center;
      }
      summary.nested-summary::-webkit-details-marker { display: none; }
      
      .nested-icon {
        color: #9ca3af; font-size: 0.65rem; margin-right: 10px; margin-top: 2px;
        transition: transform 0.2s ease; display: inline-block; flex-shrink: 0;
      }
      details[open] > summary.nested-summary .nested-icon { transform: rotate(90deg); }
      .nested-content { margin-top: 1rem; }
    </style>
  </head>
  <body>
    <div class="top-spacer"></div>
    
    <div class="container">
      <h1>福田睦晃 (Mutsuki Fukuda) - Personal Activity Archive</h1>

      <div class="ai-notice">
        <p>このページは、検索エンジンおよびAIクローラー向けの活動アーカイブ（データソース）です。</p>
        <p>視認性に優れた公式ポートフォリオをご覧になる方は、<strong><a href="https://www.notion.so/睦晃さんのNotionURL" target="_blank" rel="noopener noreferrer">Notion版プロフィール</a></strong> へアクセスしてください。</p>
      </div>

      <div>
        {processedBlocks.map((block: any) => {
          if (block.type === 'intro_group') {
            return (
              <div class="intro-container">
                {block.blocks.map((introBlock: any) => {
                  const tData = introBlock[introBlock.type];
                  return (
                    <p class="intro-paragraph">
                      {tData.rich_text.map((t: any) => t.href 
                        ? <a href={t.href} target="_blank" rel="noopener noreferrer">{t.plain_text}</a> 
                        : <span>{t.plain_text}</span>
                      )}
                    </p>
                  );
                })}
              </div>
            );
          }

          if (block.type === 'sns_group') {
            const mainKeywords = ['instagram.com', 'x.com', 'twitter.com', 'youtube.com', 'facebook.com'];
            const mainLinks = block.links.filter((url: string) => mainKeywords.some(kw => url.includes(kw)));
            const subLinks = block.links.filter((url: string) => !mainKeywords.some(kw => url.includes(kw)));

            return (
              <div class="sns-section">
                {mainLinks.length > 0 && (
                  <div class="sns-row">
                    {mainLinks.map((url: string) => {
                      const sns = getSnsDetails(url);
                      return (
                        <a href={url} target="_blank" rel="noopener noreferrer" class="sns-btn">
                          <span class="sns-icon" set:html={sns.icon}></span>{sns.name}
                        </a>
                      );
                    })}
                  </div>
                )}
                {subLinks.length > 0 && (
                  <div class="sns-row">
                    {subLinks.map((url: string) => {
                      const sns = getSnsDetails(url);
                      return (
                        <a href={url} target="_blank" rel="noopener noreferrer" class="sns-btn">
                          <span class="sns-icon" set:html={sns.icon}></span>{sns.name}
                        </a>
                      );
                    })}
                  </div>
                )}
              </div>
            );
          }

          const type = block.type;
          const typeData = block[type];
          const text = getPlainText(block);

          if (block.children && block.children.length > 0) {
            return (
              <details class="toggle-card">
                <summary class="toggle-summary">
                  <span class="toggle-icon">▶︎</span>
                  <span>{text || '詳細を見る'}</span>
                </summary>
                <div class="toggle-content">
                  {block.children.map((child: any) => {
                    if (child.children && child.children.length > 0) {
                      return (
                        <details class="nested-toggle">
                          <summary class="nested-summary">
                            <span class="nested-icon">▶︎</span>
                            <span>{getPlainText(child) || '画像 / 詳細を見る'}</span>
                          </summary>
                          <div class="nested-content">
                            {child.children.map((grandchild: any) => {
                              if (grandchild.type === 'image') {
                                const gcUrl = grandchild.image.type === 'external' ? grandchild.image.external.url : grandchild.image.file.url;
                                return <img src={gcUrl} alt="Nested Content Image" class="notion-image" />;
                              }
                              if (grandchild.type === 'paragraph' || grandchild.type.startsWith('heading_')) {
                                const gcTextData = grandchild[grandchild.type].rich_text;
                                if (!gcTextData) return null;
                                return (
                                  <div class="toggle-text">
                                    {gcTextData.map((t: any) => t.href 
                                      ? <a href={t.href} target="_blank" rel="noopener noreferrer">{t.plain_text}</a> 
                                      : <span>{t.plain_text}</span>
                                    )}
                                  </div>
                                );
                              }
                              return null;
                            })}
                          </div>
                        </details>
                      );
                    }

                    if (child.type === 'image') {
                      const childUrl = child.image.type === 'external' ? child.image.external.url : child.image.file.url;
                      return <img src={childUrl} alt="Toggle Content Image" class="notion-image" />;
                    }
                    if (child.type === 'paragraph' || child.type.startsWith('heading_')) {
                      const childTextData = child[child.type].rich_text;
                      if (!childTextData) return null;
                      return (
                        <div class="toggle-text">
                          {childTextData.map((t: any) => t.href 
                            ? <a href={t.href} target="_blank" rel="noopener noreferrer">{t.plain_text}</a> 
                            : <span>{t.plain_text}</span>
                          )}
                        </div>
                      );
                    }
                    return null;
                  })}
                </div>
              </details>
            );
          }

          if (type === 'paragraph' || type.startsWith('heading_')) {
            if (!text.trim()) return null; 
            
            if (text.startsWith('📂')) return <div class="section-title">{text}</div>;
            
            return (
              <p class="intro-paragraph">
                {typeData.rich_text.map((t: any) => t.href 
                  ? <a href={t.href} target="_blank" rel="noopener noreferrer">{t.plain_text}</a> 
                  : <span>{t.plain_text}</span>
                )}
              </p>
            );
          }

          if (type === 'image') {
            const url = typeData.type === 'external' ? typeData.external.url : typeData.file.url;
            return <img src={url} alt="Activity Image" class="notion-image" />;
          }

          return null;
        })}
      </div>
    </div>
  </body>
</html>